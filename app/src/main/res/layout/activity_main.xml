<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout

    xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"

    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"

    android:layout_width="match_parent"

    android:layout_height="match_parent"

    android:background="#F1F5F9"

    tools:context=".MainActivity">



    <!-- Header superior -->

    <LinearLayout

        android:id="@+id/headerLayout"

        android:layout_width="0dp"

        android:layout_height="wrap_content"

        android:background="@drawable/bg_header"

        android:orientation="vertical"

        android:paddingHorizontal="24dp"

        android:paddingTop="28dp"

        android:paddingBottom="20dp"

        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toTopOf="parent">



        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="Gestión de Proformas"

            android:textColor="#FFFFFF"

            android:textSize="22sp"

            android:textStyle="bold" />



        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="2dp"

            android:text="Registro e historial de ventas"

            android:textColor="#94A3B8"

            android:textSize="13sp" />

    </LinearLayout>



    <ScrollView

        android:layout_width="0dp"

        android:layout_height="0dp"

        android:fillViewport="true"

        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toBottomOf="@id/headerLayout">



        <LinearLayout

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="16dp">



            <!-- Card Principal: Formulario de Entradas -->

            <androidx.cardview.widget.CardView

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:layout_marginBottom="16dp"

                app:cardBackgroundColor="#FFFFFF"

                app:cardCornerRadius="16dp"

                app:cardElevation="3dp">



                <LinearLayout

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="20dp">



                    <TextView

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:layout_marginBottom="14dp"

                        android:text="Detalle del Producto"

                        android:textColor="#1E293B"

                        android:textSize="15sp"

                        android:textStyle="bold" />



                    <!-- Fila 1: Código y Producto -->

                    <LinearLayout

                        android:layout_width="match_parent"

                        android:layout_height="wrap_content"

                        android:layout_marginBottom="12dp"

                        android:orientation="horizontal">



                        <!-- Código -->

                        <com.google.android.material.textfield.TextInputLayout

                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                            android:layout_width="0dp"

                            android:layout_height="wrap_content"

                            android:layout_marginEnd="6dp"

                            android:layout_weight="1"

                            android:hint="Código"

                            app:boxCornerRadiusBottomEnd="10dp"

                            app:boxCornerRadiusBottomStart="10dp"

                            app:boxCornerRadiusTopEnd="10dp"

                            app:boxCornerRadiusTopStart="10dp">



                            <com.google.android.material.textfield.TextInputEditText

                                android:id="@+id/etCodigo"

                                android:layout_width="match_parent"

                                android:layout_height="wrap_content"

                                android:inputType="number"

                                android:textColor="#0F172A" />

                        </com.google.android.material.textfield.TextInputLayout>



                        <!-- Producto -->

                        <com.google.android.material.textfield.TextInputLayout

                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                            android:layout_width="0dp"

                            android:layout_height="wrap_content"

                            android:layout_marginStart="6dp"

                            android:layout_weight="2"

                            android:hint="Producto"

                            app:boxCornerRadiusBottomEnd="10dp"

                            app:boxCornerRadiusBottomStart="10dp"

                            app:boxCornerRadiusTopEnd="10dp"

                            app:boxCornerRadiusTopStart="10dp">



                            <com.google.android.material.textfield.TextInputEditText

                                android:id="@+id/etProducto"

                                android:layout_width="match_parent"

                                android:layout_height="wrap_content"

                                android:inputType="text"

                                android:textColor="#0F172A" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>



                    <!-- Fila 2: Precio y Cantidad -->

                    <LinearLayout

                        android:layout_width="match_parent"

                        android:layout_height="wrap_content"

                        android:orientation="horizontal">



                        <!-- Precio -->

                        <com.google.android.material.textfield.TextInputLayout

                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                            android:layout_width="0dp"

                            android:layout_height="wrap_content"

                            android:layout_marginEnd="6dp"

                            android:layout_weight="1"

                            android:hint="Precio (S/.)"

                            app:boxCornerRadiusBottomEnd="10dp"

                            app:boxCornerRadiusBottomStart="10dp"

                            app:boxCornerRadiusTopEnd="10dp"

                            app:boxCornerRadiusTopStart="10dp">



                            <com.google.android.material.textfield.TextInputEditText

                                android:id="@+id/etPrecio"

                                android:layout_width="match_parent"

                                android:layout_height="wrap_content"

                                android:inputType="numberDecimal"

                                android:textColor="#0F172A" />

                        </com.google.android.material.textfield.TextInputLayout>



                        <!-- Cantidad -->

                        <com.google.android.material.textfield.TextInputLayout

                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                            android:layout_width="0dp"

                            android:layout_height="wrap_content"

                            android:layout_marginStart="6dp"

                            android:layout_weight="1"

                            android:hint="Cantidad"

                            app:boxCornerRadiusBottomEnd="10dp"

                            app:boxCornerRadiusBottomStart="10dp"

                            app:boxCornerRadiusTopEnd="10dp"

                            app:boxCornerRadiusTopStart="10dp">



                            <com.google.android.material.textfield.TextInputEditText

                                android:id="@+id/etCantidad"

                                android:layout_width="match_parent"

                                android:layout_height="wrap_content"

                                android:inputType="number"

                                android:textColor="#0F172A" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>



                </LinearLayout>

            </androidx.cardview.widget.CardView>



            <!-- Card del Total (Resaltado en azul) -->

            <androidx.cardview.widget.CardView

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:layout_marginBottom="16dp"

                app:cardBackgroundColor="#2563EB"

                app:cardCornerRadius="12dp"

                app:cardElevation="2dp">



                <RelativeLayout

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:paddingHorizontal="20dp"

                    android:paddingVertical="18dp">



                    <TextView

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:layout_centerVertical="true"

                        android:text="TOTAL ACUMULADO"

                        android:textColor="#93C5FD"

                        android:textSize="12sp"

                        android:textStyle="bold" />



                    <TextView

                        android:id="@+id/tvTotal"

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:layout_alignParentEnd="true"

                        android:text="Total: S/. 0.00"

                        android:textColor="#FFFFFF"

                        android:textSize="18sp"

                        android:textStyle="bold" />

                </RelativeLayout>

            </androidx.cardview.widget.CardView>



            <!-- Card blanca envolviendo los botones -->

            <androidx.cardview.widget.CardView

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:layout_marginBottom="24dp"

                app:cardBackgroundColor="#FFFFFF"

                app:cardCornerRadius="16dp"

                app:cardElevation="3dp">



                <HorizontalScrollView

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:padding="12dp"

                    android:scrollbars="none">



                    <LinearLayout

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:orientation="horizontal">



                        <!-- Botón NUEVO -->

                        <Button

                            android:id="@+id/btnNuevo"

                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"

                            android:layout_width="130dp"

                            android:layout_height="52dp"

                            android:layout_marginEnd="8dp"

                            android:text="NUEVO"

                            android:textColor="#334155"

                            app:cornerRadius="10dp"

                            app:strokeColor="#CBD5E1"

                            app:rippleColor="#94A3B8"

                            app:icon="@android:drawable/ic_input_add"

                            app:iconTint="#334155"

                            app:iconGravity="textStart"

                            app:iconPadding="6dp" />



                        <!-- Botón GRABAR -->

                        <Button

                            android:id="@+id/btnGrabar"

                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"

                            android:layout_width="130dp"

                            android:layout_height="52dp"

                            android:layout_marginEnd="8dp"

                            android:text="GRABAR"

                            android:textColor="#334155"

                            android:textStyle="bold"

                            app:cornerRadius="10dp"

                            app:strokeColor="#CBD5E1"

                            app:rippleColor="#94A3B8"

                            app:icon="@android:drawable/ic_menu_save"

                            app:iconTint="#334155"

                            app:iconGravity="textStart"

                            app:iconPadding="6dp" />



                        <!-- Botón ACTUALIZAR -->

                        <!-- Botón ACTUALIZAR -->

                        <Button

                            android:id="@+id/btnActualizar"

                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"

                            android:layout_width="165dp"

                            android:layout_height="52dp"

                            android:layout_marginEnd="8dp"

                            android:text="ACTUALIZAR"

                            android:textColor="#334155"

                            android:textSize="12sp"

                            android:maxLines="1"

                            app:cornerRadius="10dp"

                            app:strokeColor="#CBD5E1"

                            app:rippleColor="#94A3B8"

                            app:icon="@android:drawable/ic_menu_edit"

                            app:iconTint="#334155"

                            app:iconGravity="textStart"

                            app:iconPadding="4dp" />

                        <!-- Botón ELIMINAR -->

                        <!-- Botón ELIMINAR -->

                        <Button

                            android:id="@+id/btnEliminar"

                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"

                            android:layout_width="145dp"

                            android:layout_height="52dp"

                            android:text="ELIMINAR"

                            android:textColor="#DC2626"

                            android:textSize="12sp"

                            android:maxLines="1"

                            app:cornerRadius="10dp"

                            app:strokeColor="#FECACA"

                            app:rippleColor="#FCA5A5"

                            app:icon="@android:drawable/ic_menu_delete"

                            app:iconTint="#DC2626"

                            app:iconGravity="textStart"

                            app:iconPadding="4dp" />



                    </LinearLayout>

                </HorizontalScrollView>

            </androidx.cardview.widget.CardView>



            <!-- Sección de Registros -->

            <TextView

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:layout_marginBottom="10dp"

                android:text="Lista de Productos Agregados"

                android:textColor="#475569"

                android:textSize="14sp"

                android:textStyle="bold" />



            <androidx.recyclerview.widget.RecyclerView

                android:id="@+id/rvRegistros"

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:nestedScrollingEnabled="false"

                tools:itemCount="3"

                tools:listitem="@layout/item_proforma_registro" />



        </LinearLayout>

    </ScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>