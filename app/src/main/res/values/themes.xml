?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base de la aplicación -->
    <style name="Theme.MiApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Colores primarios -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Colores secundarios -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Colores de fondo -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Estilo de ActionBar -->
        <item name="actionBarStyle">@style/Theme.MiApp.ActionBar</item>
    </style>

    <!-- Estilo para ActionBar -->
    <style name="Theme.MiApp.ActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/purple_500</item>
        <item name="titleTextColor">@color/white</item>
    </style>
</resources>